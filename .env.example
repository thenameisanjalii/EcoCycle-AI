# ==============================================================================
# EcoCycle AI - Environment Configuration Template
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Paths
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
CONFIGS_DIR=./configs

# Set this in the server process environment; backend does not auto-load .env.
ECOCYCLE_V2_BUNDLE=./ml/artifacts/pipeline_v2/run-20261111-v2.0.1

# Security (Placeholder)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
