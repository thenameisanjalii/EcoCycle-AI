# Data Files (Keep structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep

# Model Artifacts & Weights (Keep structure via .gitkeep)
artifacts/models/soh/*
!artifacts/models/soh/.gitkeep
artifacts/models/rul/*
!artifacts/models/rul/.gitkeep
artifacts/preprocessors/*
!artifacts/preprocessors/.gitkeep
artifacts/feature_metadata/*
!artifacts/feature_metadata/.gitkeep
*.pkl
*.joblib
*.pt
*.pth
*.h5
*.onnx
*.bin

# Allow required ML artifacts and data for presentation
!ml/artifacts/models/**/*.joblib
!ml/artifacts/preprocessors/**/*.joblib
!ml/artifacts/pipeline_v2/**/*.joblib
!ml/artifacts/pipeline_v3/**/*.joblib
!ml/data/*.csv

# Logs & Temporary Outputs
*.log
logs/

# Frontend Build & Node Modules
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/

# Retained local source bytes; public URLs, CRCs and SHA256s are versioned.
